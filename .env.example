# From `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# For Capacitor LAN dev, match the URL the WebView loads (e.g. http://192.168.1.x:3000).

# Local Android signed APK builds.
# Copy these values to .env.local. Never commit the keystore or passwords.
NOVEND_APP_URL=https://your-app-url.com
ANDROID_KEYSTORE_PATH=apps/mobile/android/release.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=novend-release
ANDROID_KEY_PASSWORD=

# GitHub Actions only. Store the base64-encoded keystore as a repository secret.
# ANDROID_KEYSTORE_BASE64=

# Set to 1 to register the service worker during `pnpm dev`
# NEXT_PUBLIC_OFFLINE_SW=1

# Convex Auth secrets must be set on the *deployment* (not only here):
#   npx convex env set SITE_URL http://localhost:3000
#   node scripts/setup-convex-auth.mjs
# That writes JWT_PRIVATE_KEY and JWKS. CONVEX_SITE_URL is built-in.
#
# Password-reset email (Resend). Without this, /forgot-password still works
# but no email is delivered.
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM="Novend <noreply@yourdomain.com>"
# AUTH_EMAIL_REPLY_TO=support@yourdomain.com
