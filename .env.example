# From `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Public marketing / SEO origin (sitemap, Open Graph, JSON-LD).
# Local Millie's Next+Electron share :3737 (see constants/dev-server.ts).
# Production marketing: https://www.novendpos.app
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3737

# Host split (same Next deploy, two domains on Vercel):
#   www.novendpos.app      — marketing (landing, pricing, product, docs)
#   dashboard.novendpos.app — POS / auth (/login, /signup, /dashboard, …)
#   novendpos.app           — edge redirect → www
# Apex redirect is configured in Vercel Domains, not in Next.
#
# When MARKETING_URL ≠ APP_URL, marketing “Sign in” / “Start free” CTAs point at
# the app origin (see `appEntryHref` in lib/hosting/hosts.ts). Authenticated `/`
# on www stays on the landing; on dashboard it 302s into the POS shell.
#
# Leave MARKETING_URL unset (or equal to the app URL) for single-origin localhost.
# NEXT_PUBLIC_MARKETING_URL=https://www.novendpos.app
# NEXT_PUBLIC_APP_URL=https://dashboard.novendpos.app

# For Capacitor LAN dev, match the URL the WebView loads (e.g. http://192.168.1.x:3000).
# See docs/architecture/SEO.md and docs/architecture/ROUTING.md.

# Millie's Electron: leave NOVEND_APP_URL unset. Packaged desktop embeds Next
# standalone and serves it on an ephemeral 127.0.0.1 port. Dev uses ELECTRON_DEV → :3737.
# NOVEND_APP_URL is only a rare override (never required for the till shell).
# NOVEND_APP_URL=
# ELECTRON_RENDERER_URL=http://127.0.0.1:3737

# Local Android signed APK builds.
# Copy these values to .env.local. Never commit the keystore or passwords.
ANDROID_KEYSTORE_PATH=apps/mobile/android/release.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=novend-release
ANDROID_KEY_PASSWORD=

# GitHub Actions only. Store the base64-encoded keystore as a repository secret.
# ANDROID_KEYSTORE_BASE64=

# Set to 1 to register the service worker during `pnpm dev`
# NEXT_PUBLIC_OFFLINE_SW=1

# Millie's offline license (HMAC). Must match scripts/issue-millies-license.mjs.
# Leave unset to use the built-in default secret (dev / single-store builds).
# NEXT_PUBLIC_MILLIES_LICENSE_SECRET=
# Set to 1 to skip the activation gate locally (never enable in production builds).
# NEXT_PUBLIC_MILLIES_LICENSE_DEV_BYPASS=1

# Capacitor in-app update check. Point at the Convex HTTP site URL.
# NEXT_PUBLIC_MOBILE_UPDATE_JSON=https://your-deployment.convex.site/mobile-updates/latest

# Web Push (VAPID). Generate with: node scripts/generate-vapid-keys.mjs
# Public key is safe for the client. Private key + subject go on Convex only:
#   npx convex env set VAPID_PUBLIC_KEY ...
#   npx convex env set VAPID_PRIVATE_KEY ...
#   npx convex env set VAPID_SUBJECT mailto:support@yourdomain.com
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# FCM HTTP v1 for Capacitor remote push (Convex action). Paste the full
# Firebase service-account JSON as one line. Never commit this value.
# FCM_SERVICE_ACCOUNT_JSON=

# Convex Auth secrets must be set on the *deployment* (not only here):
#   npx convex env set SITE_URL https://dashboard.novendpos.app
#   node scripts/setup-convex-auth.mjs
# That writes JWT_PRIVATE_KEY and JWKS. CONVEX_SITE_URL is built-in.
# SITE_URL must be the **app** origin (dashboard), not www — auth cookies and
# redirects after sign-in belong on the POS host.
#
# Password-reset email (Resend). Without this, /forgot-password still works
# but no email is delivered.
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM="Novend <noreply@novendpos.app>"
# AUTH_EMAIL_REPLY_TO=support@novendpos.app

# --- Monitoring & analytics (all optional; unset = disabled) ---
# Sentry error monitoring (client + server). Scrubs auth headers; no PII by default.
# NEXT_PUBLIC_SENTRY_DSN=https://…@o….ingest.sentry.io/…
# SENTRY_AUTH_TOKEN=   # optional; only for source-map upload in CI

# Google Analytics 4 — marketing site only (www). Never mount on the POS shell.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Arkesel SMS (Convex deployment env — not Next):
#   npx convex env set ARKESEL_API_KEY ...
#   npx convex env set ARKESEL_SENDER_ID Novend
# Without the key, sms.send / digests skip cleanly (same as Resend).
