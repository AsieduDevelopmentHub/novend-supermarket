{
  "name": "@novend/desktop",
  "version": "1.0.4",
  "private": true,
  "description": "Millie's Supermarket desktop shell",
  "homepage": "https://www.novendpos.app",
  "author": {
    "name": "Asiedu Development Hub",
    "email": "support@novendpos.app"
  },
  "main": "dist/main.js",
  "scripts": {
    "write-update-config": "node ../../scripts/write-desktop-update-config.mjs",
    "generate-icons": "node ../../scripts/sync-branding-from-master.mjs && node ../../scripts/generate-desktop-icons.mjs",
    "prebuild": "pnpm run write-update-config && pnpm run generate-icons",
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm run build && cross-env ELECTRON_DEV=1 electron .",
    "start": "pnpm run build && electron .",
    "dist": "pnpm run build && electron-builder",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "release": "pnpm run build && electron-builder --publish always",
    "stamp:win-icon": "node ../../scripts/stamp-desktop-win-icon.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^20",
    "rcedit": "^5.0.2",
    "cross-env": "^10.1.0",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.novend.millies",
    "productName": "Millie's Supermarket",
    "npmRebuild": false,
    "forceCodeSigning": false,
    "afterPack": "../../scripts/after-pack-stamp-win-icon.cjs",
    "artifactName": "Millies-Supermarket-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "customer-display",
        "to": "customer-display"
      },
      {
        "from": "build/update-config.json",
        "to": "update-config.json"
      },
      {
        "from": "resources/app-server",
        "to": "app-server"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "MilliesSupermarket",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Millie's Supermarket",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "installer.nsh",
      "runAfterFinish": true,
      "uninstallDisplayName": "Millie's Supermarket",
      "artifactName": "Millies-Supermarket-Setup-${version}.${ext}"
    },
    "releaseInfo": {
      "releaseName": "Millie's Supermarket ${version}"
    }
  }
}
