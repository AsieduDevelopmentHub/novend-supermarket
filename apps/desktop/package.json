{
  "name": "@novend/desktop",
  "version": "0.3.1",
  "private": true,
  "description": "Novend POS desktop shell",
  "homepage": "https://github.com/AsieduDevelopmentHub/novend-pos",
  "repository": {
    "type": "git",
    "url": "https://github.com/AsieduDevelopmentHub/novend-pos.git"
  },
  "author": {
    "name": "Asiedu Development Hub",
    "email": "asiedudev.hub@gmail.com"
  },
  "main": "dist/main.js",
  "scripts": {
    "write-update-config": "node ../../scripts/write-desktop-update-config.mjs",
    "generate-icons": "node ../../scripts/generate-desktop-icons.mjs",
    "prebuild": "pnpm run write-update-config && pnpm run generate-icons",
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm run build && cross-env ELECTRON_DEV=1 electron .",
    "start": "pnpm run build && electron .",
    "dist": "pnpm run build && electron-builder",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "release": "pnpm run build && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^20",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.novend.pos",
    "productName": "Novend POS",
    "npmRebuild": false,
    "artifactName": "Novend-POS-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": ["dist/**/*", "package.json"],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "offline-boot.html",
        "to": "offline-boot.html"
      },
      {
        "from": "build/update-config.json",
        "to": "update-config.json"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "NovendPOS",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "mac": {
      "icon": "build/icon.png",
      "target": ["dmg", "zip"],
      "category": "public.app-category.business"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": ["AppImage", "deb"],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Novend POS",
      "runAfterFinish": true,
      "uninstallDisplayName": "Novend POS",
      "artifactName": "Novend-POS-Setup-${version}.${ext}"
    },
    "releaseInfo": {
      "releaseName": "Novend POS ${version}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AsieduDevelopmentHub",
        "repo": "novend-pos",
        "releaseType": "release"
      }
    ]
  }
}
