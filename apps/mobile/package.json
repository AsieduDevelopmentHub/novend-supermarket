{
  "name": "@novend/mobile",
  "version": "1.0.29",
  "private": true,
  "description": "Millie's Supermarket Capacitor shell (Android / iOS)",
  "scripts": {
    "generate-icons": "node ../../scripts/generate-mobile-icons.mjs",
    "write-boot": "node ../../scripts/write-mobile-boot.mjs",
    "sync": "pnpm run generate-icons && pnpm run write-boot && npx cap sync android",
    "sync:ios": "pnpm run generate-icons && pnpm run write-boot && npx cap sync ios",
    "sync:all": "pnpm run generate-icons && pnpm run write-boot && npx cap sync",
    "open:android": "node ../../scripts/configure-android-studio-jdk.mjs && npx cap open android",
    "open:ios": "npx cap open ios",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor-community/bluetooth-le": "^7.3.2",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "typescript": "^5"
  }
}
