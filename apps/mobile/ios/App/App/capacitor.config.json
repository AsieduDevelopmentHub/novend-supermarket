{
  "appId": "com.novend.pos",
  "appName": "Novend POS",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost",
    "allowNavigation": ["novend-pos.vercel.app"],
    "errorPath": "error.html"
  },
  "android": {
    "allowMixedContent": false,
    "appendUserAgent": "NovendCapacitor/1.0"
  },
  "ios": {
    "appendUserAgent": "NovendCapacitor/1.0"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#0B1F33"
    }
  },
  "packageClassList": [
    "BiometricAuthNative",
    "SecureStorage",
    "BluetoothLe",
    "AppPlugin",
    "CAPCameraPlugin",
    "FilesystemPlugin",
    "HapticsPlugin",
    "LocalNotificationsPlugin",
    "PreferencesPlugin",
    "SharePlugin"
  ]
}
