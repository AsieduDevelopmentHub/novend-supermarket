{
	"appId": "com.novend.pos",
	"appName": "Novend POS",
	"webDir": "www",
	"server": {
		"url": "https://novend-pos.vercel.app",
		"cleartext": false
	},
	"android": {
		"allowMixedContent": false
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": true,
			"backgroundColor": "#0B1F33"
		}
	},
	"packageClassList": [
		"BiometricAuthNative",
		"SecureStorage",
		"BluetoothLe",
		"BarcodeScannerPlugin",
		"AppPlugin",
		"CAPCameraPlugin",
		"FilesystemPlugin",
		"HapticsPlugin",
		"LocalNotificationsPlugin",
		"PreferencesPlugin",
		"SharePlugin"
	]
}
