{
  "name": "novend-pos",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AsieduDevelopmentHub/novend-pos.git"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:all": "npm-run-all --parallel dev dev:convex",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "pnpm --filter @novend/desktop dev",
    "desktop:dist": "pnpm --filter @novend/desktop dist",
    "desktop:dist:win": "pnpm --filter @novend/desktop dist:win",
    "desktop:dist:mac": "pnpm --filter @novend/desktop dist:mac",
    "desktop:dist:linux": "pnpm --filter @novend/desktop dist:linux",
    "desktop:release": "pnpm --filter @novend/desktop release",
    "desktop:publish-convex": "node scripts/publish-desktop-release-to-convex.mjs",
    "desktop:secret": "node scripts/generate-desktop-publish-secret.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@auth/core": "^0.37.0",
    "@convex-dev/auth": "^0.0.87",
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.25.2",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.4",
    "lucide-react": "^0.525.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.60.0",
    "recharts": "^3.1.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
